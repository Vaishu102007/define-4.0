# Railway Environment Variables Template for Nimad Copilot
# Copy and paste these into your Railway Service -> Variables tab:

# Environment Mode
APP_ENV=production

# Strong 32+ character random secret for JWT signing
APP_SECRET_KEY=railway_prod_secret_replace_with_32_chars_random_key_here

# Database URL
# If you add a PostgreSQL service in Railway, Railway will auto-inject this variable!
# If you use SQLite (ephemeral without Postgres), leave it as:
DATABASE_URL=sqlite+aiosqlite:///./copilot.db

# Primary AI Provider (Groq is recommended: ultra-fast responses for live meetings)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile

# OpenAI Key (Optional fallback)
OPENAI_API_KEY=

# ElevenLabs Speech Synthesis (Optional, George voice is default)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# CORS Configuration (Allows all web traffic & railway domain)
ALLOWED_ORIGINS=https://*.up.railway.app,http://localhost:8000,http://127.0.0.1:8000

# Retention & Audio storage
SESSION_RETENTION_DAYS=30
STORE_RAW_AUDIO=false
