{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimad-copilot",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "./frontend",
  "vars": {
    "APP_NAME": "Nimad — AI Conversation Copilot",
    "APP_ENV": "production",
    // Set this to your live FastAPI backend or Cloudflare Tunnel URL
    "BACKEND_URL": "http://127.0.0.1:8000"
  }
}
