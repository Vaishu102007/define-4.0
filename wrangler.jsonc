{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "define-4-0",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist"
  },
  "pages_build_output_dir": "./dist",
  "vars": {
    "APP_NAME": "Nimad — AI Conversation Copilot",
    "APP_ENV": "production",
    "BACKEND_URL": "http://127.0.0.1:8000"
  }
}
