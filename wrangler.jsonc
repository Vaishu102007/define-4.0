{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "define-4-0",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_NAME": "Nimad — AI Conversation Copilot",
    "APP_ENV": "production",
    "BACKEND_URL": "https://simplified-confidential-whom-litigation.trycloudflare.com"
  }
}
